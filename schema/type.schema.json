{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standart.dev/schema/type.schema.json",
  "title": "STANDART type card v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sid",
    "path",
    "kind",
    "unit",
    "encodings",
    "sensitivity",
    "status",
    "title",
    "fingerprint"
  ],
  "properties": {
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ru": { "type": "string", "minLength": 1 },
        "short": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "legacy": {
          "type": "string",
          "pattern": "^std:[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "quantity",
        "enum",
        "identity",
        "temporal",
        "spatial",
        "logical",
        "media",
        "structured",
        "event",
        "command"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "encodings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "bool",
          "u8",
          "i16",
          "i32",
          "f32",
          "f64",
          "utf8",
          "bytes",
          "record",
          "enum"
        ]
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "enumValues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "personal", "restricted"]
    },
    "status": {
      "type": "string",
      "enum": ["stable", "draft", "deprecated"]
    },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ru", "en"],
      "properties": {
        "ru": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
